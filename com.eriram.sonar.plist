<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.eriram.sonar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/eriram/.gemini/antigravity/scratch/sonar/run_daily.sh</string>
    </array>

    <!-- 毎朝 07:00 (JST) に実行 -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/eriram/.gemini/antigravity/scratch/sonar/logs/launchd_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/eriram/.gemini/antigravity/scratch/sonar/logs/launchd_stderr.log</string>

    <key>WorkingDirectory</key>
    <string>/Users/eriram/.gemini/antigravity/scratch/sonar</string>
</dict>
</plist>
